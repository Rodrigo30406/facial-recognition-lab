# Copy this file to .env and adjust values for your machine.

ELECCIA_ENCODER_BACKEND=insightface
ELECCIA_INSIGHTFACE_MODEL_NAME=buffalo_l
ELECCIA_INSIGHTFACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
ELECCIA_INSIGHTFACE_CTX_ID=0
ELECCIA_INSIGHTFACE_DET_SIZE=320x320
ELECCIA_TEMPORAL_CONSISTENCY_ENABLED=true
ELECCIA_TEMPORAL_MIN_CONSISTENT_FRAMES=3

ELECCIA_RECOGNITION_THRESHOLD=0.5
ELECCIA_RECOGNITION_MARGIN=0.08
ELECCIA_RECOGNITION_TOP_K=5

ELECCIA_DATABASE_URL=sqlite:///data/db/facial_recognition.db
ELECCIA_SAMPLE_STORAGE_DIR=data/samples

# --- Camera/vision defaults (scripts/run_vision_runtime.py) ---
# Command-line flags still win over these values.
ELECCIA_CAMERA_INDEX=0
ELECCIA_CAMERA_ID=cam-01
ELECCIA_RECOGNIZE_EVERY=3
ELECCIA_SHOW_LANDMARKS=true

# Local USB capture tuning (ignored for IP cameras; they use their own config).
ELECCIA_CAMERA_WIDTH=1280
ELECCIA_CAMERA_HEIGHT=720
ELECCIA_CAMERA_FPS=30

# --- Camera source: 'local' (USB, uses ELECCIA_CAMERA_INDEX) or 'ip' (RTSP/HTTP) ---
ELECCIA_CAMERA_SOURCE=local
# For ELECCIA_CAMERA_SOURCE=ip, set host + credentials (password is URL-encoded automatically):
# ELECCIA_CAMERA_IP=192.168.1.50
# ELECCIA_CAMERA_USER=admin
# ELECCIA_CAMERA_PASSWORD=changeme
# ELECCIA_CAMERA_PORT=554
# ELECCIA_CAMERA_SCHEME=rtsp
# Stream path varies by vendor: Hikvision /Streaming/Channels/101 ; Dahua /cam/realmonitor?channel=1&subtype=0
# ELECCIA_CAMERA_RTSP_PATH=/Streaming/Channels/101
# Or skip the parts above and give the full URL (credentials injected if missing):
# ELECCIA_CAMERA_URL=rtsp://192.168.1.50:554/Streaming/Channels/101
# Camera runtime greeting (independent from core voice module)
ELECCIA_VISION_VOICE_GREET=false

# Guided enrollment defaults
ELECCIA_ENROLL_PERSON_ID=alice
ELECCIA_GUIDED_ENROLL=true
ELECCIA_GUIDED_PRESET=strict
# Embedded runtime: auto-start identification when API process starts.
# Set to true on device if you want single-process boot behavior.
ELECCIA_AUTO_START_IDENTIFICATION=false
# Eleccia Core runtime modules (used by scripts/run_eleccia_core.py):
# Supported today: vision,voice
# Supported today: vision,voice,listen,mqtt
ELECCIA_CORE_MODULES=vision,voice,listen
# MQTT command bus (optional; auto-starts if ELECCIA_MQTT_ENABLED=true)
ELECCIA_MQTT_ENABLED=false
ELECCIA_MQTT_HOST=127.0.0.1
ELECCIA_MQTT_PORT=1883
# ELECCIA_MQTT_USERNAME=
# ELECCIA_MQTT_PASSWORD=
# ELECCIA_MQTT_CLIENT_ID=
ELECCIA_MQTT_TOPIC_PREFIX=eleccia
ELECCIA_MQTT_QOS=0
ELECCIA_MQTT_RETAIN=false
# Core voice module settings (`voice` in ELECCIA_CORE_MODULES)
ELECCIA_VOICE_ENABLED=true
ELECCIA_VOICE_BACKEND=melotts
ELECCIA_VOICE_LANG=es
ELECCIA_VOICE_TEMPLATE="Hola {name}"
ELECCIA_VOICE_REENTRY_DELAY_SECONDS=10
ELECCIA_VOICE_ABSENCE_SECONDS=1.5
ELECCIA_VOICE_MIN_FACE_RATIO=0.08
ELECCIA_VOICE_GREET_UNKNOWN=false
# ELECCIA_VOICE_RATE=140
# ELECCIA_VOICE_VOLUME=1.0
# ELECCIA_VOICE_ID=
ELECCIA_MELO_LANGUAGE=ES
# ELECCIA_MELO_SPEAKER=ES
ELECCIA_MELO_SPEED=1.0
ELECCIA_MELO_DEVICE=auto
# Voice command listener module (v1 backend: stdin for local/dev)
ELECCIA_LISTEN_ENABLED=false
ELECCIA_LISTEN_BACKEND=stdin
ELECCIA_LISTEN_WAKE_WORD=eleccia
ELECCIA_LISTEN_WAKE_WORD_ALIASES=elexia,eleksia,elecia
ELECCIA_LISTEN_WAKE_WORD_FUZZY_THRESHOLD=0.80
ELECCIA_LISTEN_REQUIRE_WAKE_WORD=true
ELECCIA_LISTEN_WAKE_COMMAND_WINDOW_SECONDS=6.0
# Global audio mutex (shared by listen/voice/vision processes)
ELECCIA_AUDIO_LOCK_FILE=/tmp/eleccia_audio_io.lock
# Strict mode recommended: listen waits while voice is speaking.
ELECCIA_AUDIO_LOCK_STRICT=true
# Timeout is only used when strict mode is disabled.
ELECCIA_AUDIO_LOCK_TIMEOUT_SECONDS=10.0
ELECCIA_LISTEN_STDIN_PROMPT="eleccia> "
# Whisper STT profile (recommended for high-end GPU):
ELECCIA_LISTEN_WHISPER_MODEL=large-v3
ELECCIA_LISTEN_WHISPER_DEVICE=cuda
ELECCIA_LISTEN_WHISPER_COMPUTE_TYPE=float16
ELECCIA_LISTEN_WHISPER_LANGUAGE=es
ELECCIA_LISTEN_WHISPER_BEAM_SIZE=5
ELECCIA_LISTEN_WHISPER_VAD_FILTER=true
ELECCIA_LISTEN_WHISPER_CHUNK_SECONDS=4.0
ELECCIA_LISTEN_WHISPER_SAMPLE_RATE_HZ=16000
# ELECCIA_LISTEN_WHISPER_INPUT_DEVICE_INDEX=0
ELECCIA_LISTEN_WHISPER_MIN_RMS=0.003
# Voice-activity endpointing for whisper backend (recommended):
# Captures only while speaking, ends after silence window.
ELECCIA_LISTEN_WHISPER_ENDPOINTING_ENABLED=true
ELECCIA_LISTEN_WHISPER_FRAME_SECONDS=0.2
ELECCIA_LISTEN_WHISPER_SPEECH_START_SECONDS=0.2
ELECCIA_LISTEN_WHISPER_SILENCE_STOP_SECONDS=2.0
ELECCIA_LISTEN_WHISPER_MAX_UTTERANCE_SECONDS=8.0
ELECCIA_LISTEN_WHISPER_PRE_ROLL_SECONDS=0.3
# Gemma4 multimodal STT profile (transformers):
# ELECCIA_LISTEN_BACKEND=gemma4
ELECCIA_LISTEN_GEMMA4_MODEL=google/gemma-4-E2B-it
ELECCIA_LISTEN_GEMMA4_DEVICE_MAP=auto
ELECCIA_LISTEN_GEMMA4_TORCH_DTYPE=bfloat16
ELECCIA_LISTEN_GEMMA4_ATTN_IMPLEMENTATION=sdpa
ELECCIA_LISTEN_GEMMA4_MAX_NEW_TOKENS=96
ELECCIA_LISTEN_GEMMA4_SAMPLE_RATE_HZ=16000
ELECCIA_LISTEN_GEMMA4_CHUNK_SECONDS=6.0
ELECCIA_LISTEN_GEMMA4_MIN_RMS=0.003
ELECCIA_LISTEN_GEMMA4_TRANSCRIBE_PROMPT="Transcribe exactamente el audio en espanol. Responde solo con la transcripcion, sin explicaciones."
# Timing diagnostics (logs speech start/stop, wake detection, STT latency)
ELECCIA_LISTEN_DEBUG_TIMING=false
# Lightweight adaptive noise filter before Whisper (recommended in noisy rooms)
ELECCIA_LISTEN_NOISE_FILTER_ENABLED=false
# openWakeWord + Whisper gated mode:
# ELECCIA_LISTEN_BACKEND=openwakeword_whisper
# Comma-separated custom model paths for wakeword (e.g., Eleccia)
# ELECCIA_LISTEN_OPENWAKEWORD_MODEL_PATHS=/abs/path/eleccia.onnx
ELECCIA_LISTEN_OPENWAKEWORD_INFERENCE_FRAMEWORK=onnx
ELECCIA_LISTEN_OPENWAKEWORD_THRESHOLD=0.5
ELECCIA_LISTEN_OPENWAKEWORD_CHUNK_SIZE=1280
ELECCIA_LISTEN_OPENWAKEWORD_COOLDOWN_SECONDS=1.5
# Optional args for the in-process vision module launcher:
# ELECCIA_IDENTIFICATION_ARGS="--camera-index 0 --camera-id cam-01 --recognize-every 3 --voice-greet --voice-backend melotts --show-landmarks --landmarks-max-points 50 --landmarks-every 1"
# For MeloTTS backend, install package in your environment:
# pip install "melotts @ git+https://github.com/myshell-ai/MeloTTS.git"
# Optional playback helper:
# pip install sounddevice
# Optional pyttsx3 tuning:
# ELECCIA_VOICE_RATE=150
# ELECCIA_VOICE_VOLUME=1.0
# ELECCIA_VOICE_ID=

# --- Totem screen control (voice commands: "prende/apaga el totem") ---
# ELECCIA_TOTEM_URL=http://192.168.31.44:8090
# ELECCIA_TOTEM_TOKEN=eleccia2026
